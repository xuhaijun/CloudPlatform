# 开发环境
# 留空表示使用「相对路径」请求 —— 由 Vite devServer 的 proxy 转发到后端，
# 从而在前端侧完全不存在跨域配置，与生产 Nginx 同源反代保持一致的语义。
VITE_API_BASE_URL=
# Vite 代理的后端地址（后端默认 8080）
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_APP_TITLE=DSSAD 云平台
# 大屏/监控类页面的轮询间隔（毫秒）。后端总览缓存 TTL 为 5 秒，
# 轮询间隔必须大于缓存 TTL，否则每次轮询都打穿缓存、白白浪费数据库查询。
VITE_POLL_INTERVAL_MS=10000
