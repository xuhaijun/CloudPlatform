# ============================================================================
#  构建产物与运行期数据 —— 绝不入库
# ============================================================================

# ---- 后端 ----
cloud-platform-server/target/
*.jar
!cloud-platform-server/.mvn/wrapper/maven-wrapper.jar

# H2 本地文件库（application-local.yml 指向 ./data/db/dssad）
cloud-platform-server/data/
data/

# 本地生产态运行目录（pid + 日志，见 scripts/run-local.sh）
.run/
logs/
*.log
*.log.*

# ---- 数据库备份产物（scripts/backup.sh 的默认输出目录）----
# 备份文件含**全库数据**（含驾驶员身份信息、轨迹等个人数据），一旦入库等同于泄露；
# 因此连 .meta 旁文件一并排除，不做「只忽略 .sql.gz」这种半吊子规则。
backups/
*.sql.gz
*.sql.gz.meta

# ---- 前端 ----
cloud-platform-web/node_modules/
cloud-platform-web/dist/
cloud-platform-web/.vite/
cloud-platform-web/*.local

# ---- 密钥与凭据（镜像层永久留存，一旦进过层删文件也捞得回来）----
.env
.env.*
# 下面两个反选是**刻意为之**，不是漏网：
# cloud-platform-web/.env.{development,production} 只含 VITE_ 前缀的构建期公开配置
# （VITE_API_BASE_URL / VITE_API_PROXY_TARGET / VITE_APP_TITLE / VITE_POLL_INTERVAL_MS），
# Vite 会把 VITE_* 直接内联进前端 JS 产物，本就对任何浏览器可见，不构成密钥。
# 工具链的敏感文件扫描器只认文件名（.env.production），会误报拦提交，故在此留证。
# ⚠️ 铁律：这两个文件**永远不得**写入任何真实凭据。后端密钥一律走环境变量
#    （见 deploy/systemd/dssad-cloud-platform.env.example），一旦需要写密钥，
#    请改为 .env.production.local（已被 .env.* 忽略）并同步更新 README。
!.env.development
!.env.production
*.p12
*.jks
*.keystore
*.pem
*.key
*.crt
.jwt_secret
deploy/systemd/*.env
!deploy/systemd/*.env.example

# ---- 容器 ----
docker/volumes/
deploy/nginx/certs/

# ---- 编辑器 / 工具 ----
.idea/
.vscode/
*.iml
*.swp
*~
.workbuddy/tmp/
.workbuddy/memory/*.tmp
