# ============================================================================
#  服务器环境变量模板（systemd EnvironmentFile，也可直接当 docker compose 的 .env）
#
#  用法：
#    1) cp deploy/systemd/dssad-cloud-platform.env.example /etc/dssad/dssad-cloud-platform.env
#    2) 逐项填写，**不要留空**：prod profile 对必填项是 fail-fast 的（缺了直接启动失败）
#    3) chmod 600（里面是明文口令）
#
#  生成强随机口令：
#    bash scripts/check-env.sh --gen-secret 24
#
#  ⚠️ 本模板已提交到仓库，**真实 .env 绝不能提交**（.gitignore 已排除 .env 与 deploy/systemd/*.env）
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库（MySQL 8.0.17+）
#   ⚠️ DB_HOST 绝不要写 localhost：
#      容器里 localhost 指容器自己，连不上库 —— 这是容器化后最常见的启动失败原因。
#      容器编排里写服务名（mysql），主机部署写真实 IP/域名。
# ---------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=dssad_cloud
DB_USERNAME=dssad
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---------------------------------------------------------------------------
# Redis（多实例部署必须开；单实例可留空并设 DSSAD_REDIS_ENABLED=false）
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------------------------------------------------------------------------
# 平台身份（准入平台「招商智行」分配）
# ---------------------------------------------------------------------------
DSSAD_ENTERPRISE_ID=DSSAD-ENT-0001
DSSAD_ENTERPRISE_NAME=车路通DSSAD云平台

# ---------------------------------------------------------------------------
# MQTT（车端上行 / 云云通道）
#   DSSAD_MQTT_PASSWORD 留空时，运行期会调监管平台
#   /passport/api/v1/auth/access-enterprise-mqtt 动态换取
# ---------------------------------------------------------------------------
DSSAD_MQTT_BROKER_URL=tcp://mqtt.example.com:1883
DSSAD_MQTT_USERNAME=
DSSAD_MQTT_PASSWORD=
# 通道 A（车端直连监管平台）保持 false；通道 B（企业自建网关）设 true
DSSAD_MQTT_SUBSCRIBE_CAR=false

# ---------------------------------------------------------------------------
# 对外依赖
# ---------------------------------------------------------------------------
DSSAD_REGULATORY_BASE_URL=https://reg-platform.example.com
# 企业所在监管区域编码（地图拉取用，P-06）：按企业实际运营城市配置
DSSAD_REGULATORY_AREA_CODE=
DSSAD_SRS_URL=https://dssad.example.com
DSSAD_STORAGE_PUBLIC_URL=https://dssad.example.com/media
DSSAD_STORAGE_TYPE=local
DSSAD_STORAGE_ROOT=/data/dssad/media
DSSAD_LOG_DIR=/var/log/dssad

# ---------------------------------------------------------------------------
# 管理端登录口令
#   ⚠️ 不设置会静默回落到开发默认口令 admin/dssad@2026，生产上等于没有鉴权。
# ---------------------------------------------------------------------------
DSSAD_ADMIN_USER=admin
DSSAD_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---------------------------------------------------------------------------
# 数据生命周期（按磁盘容量反推，别拍脑袋）
#   1000 台车 1Hz 轨迹 ≈ 8640 万行/天 ≈ 14GB/天 → 保留 30 天约 430GB
#   设为 0 表示不清理，只适用于刚接入、数据量极小的场景
# ---------------------------------------------------------------------------
DSSAD_TRACK_RETENTION_DAYS=90
DSSAD_STATE_RETENTION_DAYS=180
DSSAD_RETENTION_BATCH_SIZE=5000
DSSAD_AUDIT_MODE=sampled
DSSAD_AUDIT_SAMPLE_RATE=0.05
DSSAD_AUDIT_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Actuator 来源 IP 白名单（fail-closed）
#
#   /actuator/** 不受管理端令牌保护（拦截器只覆盖 /api/v1/**），
#   所以这里配的就是「唯一允许访问的集合」，其余来源一律 404。
#
#   systemd 部署下 Nginx 与应用同机，proxy_pass 到 127.0.0.1 → 默认值即可。
#   容器/K8s 部署时源地址是容器或节点 IP，必须补上对应网段，例如：
#     DSSAD_ACTUATOR_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
#   留空 = 拒绝所有来源（彻底关闭 Actuator 的 HTTP 访问）。
#   配错（非法 CIDR）会导致**应用启动失败** —— 这是刻意的，不允许静默降级。
# ---------------------------------------------------------------------------
DSSAD_ACTUATOR_ALLOWED_CIDRS=127.0.0.1/32,::1/128

# ---------------------------------------------------------------------------
# JVM
# ---------------------------------------------------------------------------
JAVA_OPTS=-Xms1g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/log/dssad/heapdump.hprof -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
