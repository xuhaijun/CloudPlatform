# ============================================================================
#  换行符锁定
#
#  背景：Windows 上 Git for Windows 的系统级配置是 core.autocrlf=true，
#  检出时会把文本文件转成 CRLF。项目里的 shell 脚本一旦是 CRLF，
#  上传到 Linux 后执行会报：
#      /bin/bash^M: bad interpreter: No such file or directory
#  这个错误信息完全不指向「换行符」这个真实原因，排错成本极高，
#  所以在仓库层面锁死，而不是靠每个人记得改本地配置。
# ============================================================================

* text=auto eol=lf

# 必须在 Linux 上执行的脚本：强制 LF
*.sh          text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
*.conf        text eol=lf
*.service     text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.sql         text eol=lf
*.xml         text eol=lf
*.java        text eol=lf
*.md          text eol=lf
*.ts          text eol=lf
*.vue         text eol=lf
*.json        text eol=lf

# Windows 专用脚本：保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制：禁止任何转换
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.p12   binary
*.jks   binary
*.keystore binary
